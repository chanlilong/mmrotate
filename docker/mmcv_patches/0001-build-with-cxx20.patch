mmcv 2.1.0: compile the ops with C++20 instead of C++17.

PyTorch >= 2.10 headers require C++20 (ATen/ATen.h: "#error C++20 or later compatible
compiler is required to use ATen"), but mmcv 2.1.0's setup.py hard-codes -std=c++17 for
both the host compiler and nvcc, so every op fails to compile against torch 2.14.

--- a/setup.py	2026-10-22 21:30:46
+++ b/setup.py	2026-10-22 21:30:46
@@ -204,12 +204,12 @@
             if parse_version(torch.__version__) <= parse_version('1.12.1'):
                 extra_compile_args['cxx'] = ['-std=c++14']
             else:
-                extra_compile_args['cxx'] = ['-std=c++17']
+                extra_compile_args['cxx'] = ['-std=c++20']
         else:
             if parse_version(torch.__version__) <= parse_version('1.12.1'):
                 extra_compile_args['cxx'] = ['/std:c++14']
             else:
-                extra_compile_args['cxx'] = ['/std:c++17']
+                extra_compile_args['cxx'] = ['/std:c++20']
 
         include_dirs = []
         library_dirs = []
@@ -429,7 +429,7 @@
             if parse_version(torch.__version__) <= parse_version('1.12.1'):
                 extra_compile_args['nvcc'] += ['-std=c++14']
             else:
-                extra_compile_args['nvcc'] += ['-std=c++17']
+                extra_compile_args['nvcc'] += ['-std=c++20']
 
         ext_ops = extension(
             name=ext_name,
