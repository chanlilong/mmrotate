# syntax=docker/dockerfile:1
# MMRotate dev image + the TensorRT deployment stack used by mmrotate/tensorrt (see
# mmrotate/tensorrt/TENSORRT.md): TensorRT (Python API, CUDA 13 build), ModelOpt (INT8 / FP8
# quantizers), onnx and onnxruntime (export tests).
#
# Derived from the dev image, so build that first (docker/Dockerfile), then:
#   docker build -f docker/Dockerfile.trt -t mmrotate-trt docker
#   docker build -f docker/Dockerfile.trt --build-arg BASE=mmrotate-dev:2026.10.24 -t mmrotate-trt docker
# Run it like the dev image, with the repo mounted over /mmrotate:
#   docker run --rm -it --gpus all --ipc host -v "$PWD":/mmrotate -v /mnt:/mnt mmrotate-trt
#
# No CUDA toolkit is needed: the MSDeformAttn plugin is a Triton kernel compiled to PTX at export
# time, not a C++ plugin.
ARG BASE="mmrotate-dev:latest"
FROM ${BASE}

ARG TENSORRT="11.4.0.106"
ARG MODELOPT="0.47.0"

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# /opt/constraints.txt (PIP_CONSTRAINT, set in the base image) keeps the torch / triton / numpy
# stack that mmcv._ext was built against. ModelOpt is installed without the [onnx] extra.
RUN python -m pip install \
        "tensorrt-cu13==${TENSORRT}" \
        "nvidia-modelopt==${MODELOPT}" \
        onnx onnxruntime

RUN python - <<'EOF'
from importlib.metadata import version

import modelopt.torch.quantization  # noqa: F401
import onnx
import tensorrt as trt
import tensorrt.plugin as trtp
import torch
import triton

for pin in open('/opt/constraints.txt').read().split():
    name, want = pin.split('==')
    assert version(name) == want, f'{name} changed to {version(name)}, expected {want}'
assert hasattr(trtp, 'aot_impl'), 'tensorrt.plugin has no AOT plugins (needs TensorRT >= 10.9)'
print(f'tensorrt {trt.__version__} | modelopt {version("nvidia-modelopt")} | onnx {onnx.__version__}'
      f' | torch {torch.__version__} | triton {triton.__version__}')
EOF

CMD ["/bin/bash"]
